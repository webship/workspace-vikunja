{
  "name": "@webship.co/workspace-vikunja",
  "version": "1.0.1",
  "description": "Vikunja for Webship Workspace: the builder (`cmd-vikunja-project.sh`, a site of the open-source to-do and project management app, from Vikunja's own image on the project's own MariaDB, in containers: DDEV, with the default accounts sharing a sample project in their permissions and its tasks, a label, an assignee, a comment and its board) and its tool in every sites folder, the Vikunja step pack wired into the testing setup, the tasks of a Vikunja as work items of the tracker family (list, read, analyze, and do the work with the workspace's AI CLI on a branch; comments, moves on the board, labels and assignees after a person's click, writes off by default), and its AI items in their folders.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-vikunja.git"
  },
  "workspacePlugin": {
    "name": "vikunja",
    "label": "Vikunja",
    "summary": "A builder for Vikunja sites with a sample project and its board; its tasks as work items",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "typeActions": {
      "vikunja": [
        "sites",
        "code"
      ]
    },
    "settingsFile": "plugin.vikunja.settings.yml",
    "settingsTemplate": "config/plugin.vikunja.settings.yml",
    "labels": "config/settings.labels.yml",
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-vikunja-project.sh",
        "commands/cmd-tools-vikunja-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-vikunja.sh"
      ],
      "args": [
        "scripts/args/arg-vikunja.sh",
        "scripts/args/arg-vikunja-cli.sh"
      ],
      "machine": [
        "scripts/docker-compose.vikunja.yaml",
        "scripts/vikunja-site.php",
        "scripts/vikunja-serve.sh",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/vikunja-site-builder.md",
        "ai/agents/vikunja-tester.md",
        "ai/agents/vikunja-issue-worker.md"
      ],
      "skills": [
        "ai/skills/vikunja-scenarios"
      ],
      "commands": [
        "ai/commands/vikunja-test.md"
      ],
      "prompts": [
        "ai/prompts/vikunja-build-and-test.md",
        "ai/prompts/vikunja-issue-to-branch.md"
      ]
    },
    "features": [
      "features/vikunja.feature",
      "features/vikunja-runtimes.feature"
    ],
    "featuresSite": "cmd-vikunja-project.sh ci-vikunja --install --add-users --sample-content --runtime docker"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "dependencies": {
    "@webship.co/workspace-tracker": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
